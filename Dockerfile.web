# syntax=docker/dockerfile:1
#
# Production SPA image. Build from the repository root:
#   docker build -f Dockerfile.web -t pysplit-web .
FROM docker.io/library/node:24-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Same-origin /api is the production default. Override only for a split origin
# (the backend CORS allowlist must include that origin).
ARG VITE_API_BASE_URL=/api
ARG VITE_IMAGE_MAX_DIMENSION=1600
ARG VITE_IMAGE_QUALITY=0.82
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_IMAGE_MAX_DIMENSION=${VITE_IMAGE_MAX_DIMENSION} \
    VITE_IMAGE_QUALITY=${VITE_IMAGE_QUALITY}
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.29-alpine AS runtime

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/nginx-security-headers.conf /etc/nginx/snippets/pysplit-security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Images are built from a git checkout on the production host. When that
# account has a restrictive umask (0077 is common on hardened hosts), git
# creates the working tree with mode 0600 and COPY preserves it. The files are
# then root:root 0600 inside the image, and the runtime user cannot read them:
#
#   nginx: [emerg] open() "/etc/nginx/conf.d/default.conf"
#           failed (13: Permission denied)
#
# The API image only survived this because it chowns /app to its runtime user.
# Normalize the web image explicitly instead of trusting the checkout umask.
# The base image sets USER 101, so an unqualified RUN would execute as the
# unprivileged user and chmod would fail with "Operation not permitted".
# Switch to root only for the normalization step, then drop back.
USER 0
RUN chmod 0755 /etc/nginx/snippets \
    && chmod 0644 /etc/nginx/conf.d/default.conf \
                  /etc/nginx/snippets/pysplit-security-headers.conf \
    && chmod -R a+rX /usr/share/nginx/html

# The unprivileged image already defaults to UID 101; state it explicitly so
# the runtime contract stays visible if the base image changes.
USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
