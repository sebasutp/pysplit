# pysplit configuration template.
#
# Development quick start:
#   cp .env.example .env
#   ./dev
#
# Production (Docker Compose):
#   cp .env.example .env
#   set BASE_URL and JWT_SECRET (and provider credentials)
#   docker compose build && docker compose up -d
#
# ./dev loads .env from the repository root. Variables exported in your shell
# take precedence. Every value below belongs to the API unless it starts with
# VITE_ (browser build) or is marked as a Compose-only setting. Never commit a
# real .env or a production secret.

# --- Development hostname ----------------------------------------------------
# Hostname clients use. Vite only accepts this value in the Host header.
WEB_HOST=127.0.0.1
# Local Vite port. With a reverse proxy this is internal; the browser sees the
# public origin below.
WEB_PORT=5173
# Exact origin the browser opens. It is used for OAuth redirect URIs, secure
# cookies and CSRF checks, and must match the URL in the address bar. When
# unset, ./dev uses http://$WEB_HOST:$WEB_PORT.
# Local default:
# PUBLIC_ORIGIN=http://127.0.0.1:5173
# Behind Caddy/Tailscale with TLS termination:
# PUBLIC_ORIGIN=https://5172.test.domain.app
# Internal API port. ./dev falls forward to the next free port if 8000 is busy.
# API_PORT=8000
# Directory for development data (SQLite database and uploads).
# DATA_DIR=./data/dev

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
# APP_NAME=pysplit
# APP_VERSION=0.1.0
# DEBUG=false
# API_PREFIX=/api
# Leave unset to use the development database under DATA_DIR. Relative paths
# resolve from the backend working directory. In Docker use the absolute
# four-slash form: sqlite:////data/pysplit.db
# DATABASE_URL=sqlite:///./data/dev/pysplit.db
# SQLITE_BUSY_TIMEOUT_MS=5000
# Only needed for a split frontend/API origin. The same-origin /api proxy does
# not use CORS.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional full-origin regex for dynamic development subdomains.
# CORS_ORIGIN_REGEX=

# --- Logging and observability ----------------------------------------------
# text or json. Production should use json so request ids and status/duration
# fields are machine-readable.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# REQUEST_ID_HEADER=X-Request-ID
# Optional. Install sentry-sdk in the image to enable; no DSN means no calls.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Authentication ----------------------------------------------------------
# Google login is optional in development; ./dev also enables mock login.
# Register this exact redirect URI in Google Cloud:
#   ${BASE_URL or PUBLIC_ORIGIN}/api/auth/oauth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub login (optional).
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Required only with ENVIRONMENT=production: a unique value of at least 32
# characters. Startup fails with the development default.
# JWT_SECRET=
# Access tokens live in SPA memory; refresh tokens rotate in an HttpOnly
# cookie scoped to /api/auth.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# OAUTH_STATE_TTL_SECONDS=600
# REFRESH_COOKIE_NAME=pysplit_refresh
# CSRF_COOKIE_NAME=pysplit_csrf
# OAUTH_STATE_COOKIE_NAME=pysplit_oauth_state
# OAUTH_RETURN_TO_COOKIE_NAME=pysplit_oauth_return_to
# AUTH_COOKIE_PATH=/api/auth

# Public origin the browser uses. Required in production; use https.
# BASE_URL=https://spliit.example.com
# Optional split-origin SPA URL. With the same-origin /api proxy, leave unset.
# FRONTEND_URL=
# Optional parent cookie domain for sibling subdomains.
# COOKIE_DOMAIN=
# Set only when a trusted reverse proxy overwrites X-Forwarded-* headers.
# TRUST_FORWARDED_HEADERS=true
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Development-only passwordless login. Always unavailable when
# ENVIRONMENT=production, even if this is true.
# ENABLE_MOCK_LOGIN=false

# Authentication rate limits (per minute and window seconds).
# AUTH_RATE_LIMIT_PER_MINUTE=30
# AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=60
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Synchronization ---------------------------------------------------------
# Replay results are retained for 7 days; the change feed for 30 days.
# A cursor older than the retained window requires bootstrap.
# SYNC_OPERATION_RETENTION_DAYS=7
# SYNC_CHANGE_RETENTION_DAYS=30
# SYNC_RATE_LIMIT_PER_MINUTE=120

# --- Optional features -------------------------------------------------------
# ./dev enables these automatically for local development. Production defaults
# are off. AI endpoints also require a signed-in user and a configured key.
# ENABLE_RECEIPT_EXTRACT=true
# ENABLE_RECEIPT_ITEMS=true
# ENABLE_CATEGORY_EXTRACT=true
# ENABLE_EXPENSE_DOCUMENTS=true

# --- Uploads and storage -----------------------------------------------------
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_BYTES=10485760
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# UPLOAD_RATE_LIMIT_PER_MINUTE=60

# S3-compatible storage (optional; local disk is used when unset). The
# key/secret/bucket/region quartet selects the S3 adapter.
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=auto
# S3_UPLOAD_ENDPOINT=
# S3_PUBLIC_URL=

# --- AI receipt/category extraction -----------------------------------------
# AI_* variables take precedence over the historical OPENAI_* names. Keys are
# server-only and must never be exposed as VITE_* variables.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL_RECEIPT_EXTRACT=
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=
# AI_MODEL_CATEGORY_EXTRACT=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_RECEIPT_EXTRACT=
# OPENAI_MODEL_RECEIPT_ITEMS_EXTRACT=
# OPENAI_MODEL_CATEGORY_EXTRACT=
# AI_TIMEOUT_SECONDS=60
# AI_RATE_LIMIT_PER_MINUTE=20

# --- Receipt limits ----------------------------------------------------------
# MAX_RECEIPT_ITEMS=200
# MAX_RECEIPT_ITEM_NAME_LENGTH=200
# MAX_RECEIPT_ITEM_AMOUNT=1000000000
# MAX_RECEIPT_ITEM_QUANTITY_MILLI=1000000000
# MAX_RECEIPT_ITEM_PORTIONS=100
# RECEIPT_EXTRACTION_STALE_SECONDS=300
# RECEIPT_MAX_ATTEMPTS=3

# --- Production Compose settings --------------------------------------------
# Host port for the nginx web tier. The API is only reachable inside the
# Compose network.
# WEB_PORT=8080
# Scheduled backup sidecar (docker compose --profile backup up -d backup).
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14

# --- Frontend ----------------------------------------------------------------
# Default: same-origin /api, proxied by Vite in development and nginx in
# production. Do not point this at the internal API port.
# VITE_API_BASE_URL=/api
# ./dev sets the proxy target to its internal API port. Override only when
# running the Vite server separately.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Set false only for an HTTPS proxy target with a self-signed certificate.
# VITE_API_PROXY_SECURE=false
# Set true when the proxy target needs its own Host header (virtual hosting).
# VITE_API_PROXY_CHANGE_ORIGIN=true
# VITE_APP_NAME=pysplit
