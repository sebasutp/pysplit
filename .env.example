# Canonical environment template for pysplit.
#
# Backend-only run: copy this file to backend/.env
#   cp .env.example backend/.env
# The frontend VITE_* keys at the bottom are ignored by the API.
#
# Combined deployment: copy this file to .env at the repository root for the
# future compose stack (Stage 12), which consumes backend and frontend values
# together.
#
# ./dev does not load .env files; it reads exported shell variables instead.

# --- Application ------------------------------------------------------------
APP_NAME=pysplit
# Reported by the health endpoint; usually left at the package default.
APP_VERSION=0.1.0
# `development` is for local use only and is never a safe production default.
# Production deployments must set ENVIRONMENT=production.
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/dev/pysplit.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---------------------------------------------------------
# Development-only default; production refuses it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_STATE_TTL_SECONDS=600
# Public origin used for OAuth redirect URIs and CSRF origin checks.
# Production requires an http(s) URL (for example https://spliit.example.com).
BASE_URL=
# Cookie policy. When unset, COOKIE_SECURE follows the environment (true in
# production, and for HTTPS BASE_URLs). The names rarely need changing.
# COOKIE_SECURE=
# REFRESH_COOKIE_NAME=pysplit_refresh
# CSRF_COOKIE_NAME=pysplit_csrf
# OAUTH_STATE_COOKIE_NAME=pysplit_oauth_state
# OAUTH_RETURN_TO_COOKIE_NAME=pysplit_oauth_return_to
# AUTH_COOKIE_PATH=/api/auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Development/test only: enables POST /api/auth/mock-login. Default false.
# WARNING: this bypasses normal OAuth sign-in. Never enable it in production.
ENABLE_MOCK_LOGIN=false
# Only enable this when a trusted reverse proxy sets X-Forwarded-* headers.
# Leaving it on without a trusted proxy lets clients spoof scheme/host.
TRUST_FORWARDED_HEADERS=false

# --- Uploads and runtime feature flags --------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_RATE_LIMIT_PER_MINUTE=60
ENABLE_RECEIPT_EXTRACT=false
ENABLE_RECEIPT_ITEMS=false
ENABLE_CATEGORY_EXTRACT=false
ENABLE_EXPENSE_DOCUMENTS=false

# Receipt limits and claim recovery (Stage 7)
MAX_RECEIPT_ITEMS=200
MAX_RECEIPT_ITEM_NAME_LENGTH=200
MAX_RECEIPT_ITEM_AMOUNT=1000000000
MAX_RECEIPT_ITEM_QUANTITY_MILLI=1000000000
MAX_RECEIPT_ITEM_PORTIONS=100
RECEIPT_EXTRACTION_STALE_SECONDS=300
# Failed extractions are retryable, but each retry is another paid model call.
# Once this cap is reached the image must be uploaded again.
RECEIPT_MAX_ATTEMPTS=3

# Synchronization retention and limits (Stage 6)
SYNC_OPERATION_RETENTION_DAYS=7
SYNC_CHANGE_RETENTION_DAYS=30
# Per-caller budget for synchronization endpoints (single worker).
SYNC_RATE_LIMIT_PER_MINUTE=120

# --- Optional S3-compatible storage (Stage 7) -------------------------------
# Leave unset for local disk. S3_PUBLIC_URL is for providers such as
# Cloudflare R2 that serve objects from a different public host.
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=auto
# S3_UPLOAD_ENDPOINT=
# S3_PUBLIC_URL=

# --- AI receipt/category extraction (Stage 7) -------------------------------
# AI_* takes precedence over the historical OPENAI_* fallbacks.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL_RECEIPT_EXTRACT=
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=
# AI_MODEL_CATEGORY_EXTRACT=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_RECEIPT_EXTRACT=
# OPENAI_MODEL_RECEIPT_ITEMS_EXTRACT=
# OPENAI_MODEL_CATEGORY_EXTRACT=
AI_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_MINUTE=20

# --- Frontend (only VITE_* values reach the browser) -------------------------
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_APP_NAME=pysplit

# ---------------------------------------------------------------------------
# Reserved for later stages. Leave unset until the stage that implements them.
# ---------------------------------------------------------------------------
