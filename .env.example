# Backend runtime (FastAPI)
APP_NAME=pysplit
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/dev/pysplit.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Authentication (Stage 4)
# JWT_SECRET is required in production and must not be the development default.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Uploads and runtime feature flags (Stage 5)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
ENABLE_RECEIPT_EXTRACT=false
ENABLE_RECEIPT_ITEMS=false
ENABLE_CATEGORY_EXTRACT=false
ENABLE_EXPENSE_DOCUMENTS=false

# Synchronization retention (Stage 6)
SYNC_OPERATION_RETENTION_DAYS=7
SYNC_CHANGE_RETENTION_DAYS=30

# Frontend (only VITE_* values reach the browser)
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_APP_NAME=pysplit

# ---------------------------------------------------------------------------
# Reserved for later stages. Leave unset until the stage that implements them.
# ---------------------------------------------------------------------------
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=auto
# S3_UPLOAD_ENDPOINT=
# S3_PUBLIC_URL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL_RECEIPT_EXTRACT=
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=
# AI_MODEL_CATEGORY_EXTRACT=
