# Production Compose template. Copy to .env on the deployment host:
#
#   cp .env.production.example .env
#   openssl rand -hex 32        # use this value for JWT_SECRET
#   docker compose config
#   docker compose build && docker compose up -d
#
# Never commit the filled .env. This file is intentionally separate from the
# development .env.example: it keeps ENVIRONMENT=production active so startup
# rejects a missing/weak JWT secret and insecure cookie settings.

# --- Required production settings -------------------------------------------
ENVIRONMENT=production
# Compose-only switch; keep it explicit for staging overrides.
PYSPLIT_ENVIRONMENT=production
# Public HTTPS origin. OAuth redirects, CSRF checks and secure cookies use it.
BASE_URL=https://spliit.example.com
# Generate with: openssl rand -hex 32 (at least 32 characters).
JWT_SECRET=
# Host port for nginx. The API is not published to the host.
COMPOSE_WEB_PORT=8080
# nginx overwrites X-Forwarded-* and the API is not published.
TRUST_FORWARDED_HEADERS=true
ENABLE_MOCK_LOGIN=false
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Database and uploads ----------------------------------------------------
# Absolute four-slash form inside the Compose volume.
DATABASE_URL=sqlite:////data/pysplit.db
UPLOAD_DIR=/data/uploads
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Backups -----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- OAuth (optional; register ${BASE_URL}/api/auth/oauth/<provider>/callback)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- Optional features (default off in production) ---------------------------
# ENABLE_RECEIPT_EXTRACT=false
# ENABLE_RECEIPT_ITEMS=false
# ENABLE_CATEGORY_EXTRACT=false
# ENABLE_EXPENSE_DOCUMENTS=false

# --- Optional S3-compatible storage -----------------------------------------
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=auto
# S3_UPLOAD_ENDPOINT=
# S3_PUBLIC_URL=

# --- Optional AI receipt/category extraction --------------------------------
# Server-only. Never expose these as VITE_* values.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL_RECEIPT_EXTRACT=
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=
# AI_MODEL_CATEGORY_EXTRACT=

# --- Optional error reporting -----------------------------------------------
# Install sentry-sdk in the image before enabling this.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Edge proxy --------------------------------------------------------------
# TLS terminates before nginx. HSTS belongs on that edge, not here.
# CORS_ORIGINS=https://spliit.example.com
