#!/usr/bin/env bash
#
# Start the API and the Vite dev server together against data/dev/.
#
# Put local settings in .env at the repository root (see .env.example); shell
# variables still take precedence. Set ENV_FILE to load a different file.
#   ./dev
#
# Everything is reached through the web port; Vite proxies /api to the API.
# Set WEB_HOST to the hostname clients use (for example a Tailscale name):
#
#   ./dev                                  # http://127.0.0.1:5173
#   WEB_HOST=myhost.tailnet.ts.net ./dev   # http://myhost.tailnet.ts.net:5173
#   WEB_HOST=myhost.tailnet.ts.net WEB_PORT=5180 ./dev
#
# When an HTTPS reverse proxy (Tailscale Serve, Caddy, nginx, a tunnel)
# terminates TLS in front of Vite, set PUBLIC_ORIGIN to the exact browser
# origin. BASE_URL, OAuth redirect URIs and secure cookies all follow it:
#
#   WEB_HOST=app.example.com PUBLIC_ORIGIN=https://app.example.com ./dev
#
# Google OAuth redirect URI to register in that case:
#   https://app.example.com/api/auth/oauth/google/callback
#
# The API itself always binds to loopback and is not exposed directly.
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"

# Load local development settings from .env (or ENV_FILE). Variables already
# exported in the caller's shell win, so `WEB_PORT=5180 ./dev` still behaves as
# expected. This deliberately uses a small parser instead of `source` so values
# containing spaces, quotes or `#` are handled predictably.
declare -A DOTENV_PRESET=()
for _name in $(compgen -e); do DOTENV_PRESET["$_name"]=1; done

load_dotenv() {
  local file="$1" line key value
  [ -f "$file" ] || return 0

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"

    case "$line" in
      '' | '#'*) continue ;;
      export[[:space:]]*) line="${line#export}"; line="${line#"${line%%[![:space:]]*}"}" ;;
    esac

    key="${line%%=*}"
    [ "$key" = "$line" ] && continue
    value="${line#*=}"

    key="${key%"${key##*[![:space:]]}"}"
    key="${key#"${key%%[![:space:]]*}"}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue

    value="${value#"${value%%[![:space:]]*}"}"
    if [[ "$value" == \"* ]]; then
      value="${value:1}"
      value="${value%%\"*}"
    elif [[ "$value" == \'* ]]; then
      value="${value:1}"
      value="${value%%\'*}"
    else
      value="${value%%[[:space:]]#*}"
      value="${value%"${value##*[![:space:]]}"}"
    fi

    [ -n "${DOTENV_PRESET[$key]:-}" ] && continue
    export "$key=$value"
  done <"$file"
}

ENV_FILE="${ENV_FILE:-$ROOT/.env}"
load_dotenv "$ENV_FILE"

DATA_DIR="${DATA_DIR:-$ROOT/data/dev}"

# WEB_HOST is the single hostname knob: Vite accepts it in the Host header and
# prints it in the URL (binding all interfaces when it is not loopback). The
# API is only reachable through the Vite proxy on this host.
WEB_HOST="${WEB_HOST:-127.0.0.1}"
WEB_PORT="${WEB_PORT:-5173}"

# Browser-facing origin. Keep the default when you open Vite directly, or set
# PUBLIC_ORIGIN (or BASE_URL) to the public HTTPS URL when a reverse proxy
# fronts the dev server. BASE_URL is what the API uses for OAuth redirect URIs,
# CSRF checks and cookie security, so it must match the browser's address.
PUBLIC_ORIGIN="${PUBLIC_ORIGIN:-http://$WEB_HOST:$WEB_PORT}"

# Internal only. Clients never connect to this address directly.
API_BIND_HOST="127.0.0.1"
DEFAULT_API_PORT=8000
API_PORT_EXPLICIT="${API_PORT:-}"
API_PORT="${API_PORT:-$DEFAULT_API_PORT}"

# Return 0 when host:port can be bound. Used only to keep the default API port
# from colliding with an unrelated local service.
port_is_free() {
  python3 - "$1" "$2" <<'PY'
import socket
import sys

host, port = sys.argv[1], int(sys.argv[2])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    try:
        sock.bind((host, port))
    except OSError:
        raise SystemExit(1)
PY
}

if ! port_is_free "$API_BIND_HOST" "$API_PORT"; then
  if [ -n "$API_PORT_EXPLICIT" ]; then
    echo "API port $API_PORT is already in use. Set API_PORT to a free port." >&2
    exit 1
  fi
  while ! port_is_free "$API_BIND_HOST" "$API_PORT"; do
    API_PORT=$((API_PORT + 1))
    if [ "$API_PORT" -gt 65535 ]; then
      echo "No free API port found." >&2
      exit 1
    fi
  done
  echo "Port $DEFAULT_API_PORT is busy; using API port $API_PORT." >&2
fi

if [ ! -x "$BACKEND/.venv/bin/uvicorn" ]; then
  echo "Missing backend virtualenv. Run: make install" >&2
  exit 1
fi

if [ ! -d "$FRONTEND/node_modules" ]; then
  echo "Missing frontend dependencies. Run: make install" >&2
  exit 1
fi

mkdir -p "$DATA_DIR"

export DATABASE_URL="${DATABASE_URL:-sqlite:///$DATA_DIR/pysplit.db}"
export UPLOAD_DIR="${UPLOAD_DIR:-$DATA_DIR/uploads}"
export WEB_HOST
export WEB_PORT
export VITE_API_PROXY_TARGET="${VITE_API_PROXY_TARGET:-http://$API_BIND_HOST:$API_PORT}"
# The browser talks to Vite, so OAuth redirect URIs and CSRF origin checks must
# use the public web origin rather than the internal API address.
export BASE_URL="${BASE_URL:-$PUBLIC_ORIGIN}"
# Passwordless login is used by local development and the Playwright suite. It
# is opt-in in the application and always disabled in production.
export ENABLE_MOCK_LOGIN="${ENABLE_MOCK_LOGIN:-true}"
# Local development defaults to the Stage 8D online features. Production keeps
# the opt-in defaults from the application settings.
export ENABLE_RECEIPT_AI="${ENABLE_RECEIPT_AI:-true}"
export ENABLE_CATEGORY_EXTRACT="${ENABLE_CATEGORY_EXTRACT:-true}"
# The Playwright suite signs in per test context; keep the local limiter from
# throttling a full run. Production keeps the conservative defaults.
export AUTH_RATE_LIMIT_PER_MINUTE="${AUTH_RATE_LIMIT_PER_MINUTE:-1000}"
export SYNC_RATE_LIMIT_PER_MINUTE="${SYNC_RATE_LIMIT_PER_MINUTE:-1000}"
export AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE="${AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE:-1000}"

# Keep the local database in step with the checked-in migrations before the API
# opens it. `upgrade head` applies only pending revisions and is a no-op when
# the schema is already current, so it is safe on every dev start.
echo "Applying database migrations (if any)..."
(
  cd "$BACKEND"
  PYTHONPATH=. .venv/bin/alembic upgrade head
)

cleanup() {
  trap - EXIT INT TERM
  if [ -n "${API_PID:-}" ]; then kill "$API_PID" 2>/dev/null || true; fi
  if [ -n "${WEB_PID:-}" ]; then kill "$WEB_PID" 2>/dev/null || true; fi
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

(
  cd "$BACKEND"
  PYTHONPATH=. exec .venv/bin/uvicorn app.main:app \
    --host "$API_BIND_HOST" --port "$API_PORT" --reload
) &
API_PID=$!

(
  cd "$FRONTEND"
  # Run Vite directly so the PID we track is the server itself, not npm.
  # WEB_HOST/WEB_PORT/VITE_API_PROXY_TARGET are exported above; vite.config.js
  # uses them for binding, allowed Host headers and the /api proxy.
  exec ./node_modules/.bin/vite
) &
WEB_PID=$!

echo "Web:  $BASE_URL"
echo "API:  proxied at $BASE_URL/api (internal: http://$API_BIND_HOST:$API_PORT)"
echo "Data: $DATA_DIR"

wait -n "$API_PID" "$WEB_PID"
