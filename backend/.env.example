# Copy to backend/.env for local development.
APP_NAME=pysplit
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/dev/pysplit.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Authentication ---------------------------------------------------------
# Development-only default; production refuses it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Public origin used for OAuth redirect URIs (e.g. https://spliit.example.com).
BASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Uploads and runtime feature flags --------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
ENABLE_RECEIPT_EXTRACT=false
ENABLE_RECEIPT_ITEMS=false
ENABLE_CATEGORY_EXTRACT=false
ENABLE_EXPENSE_DOCUMENTS=false
