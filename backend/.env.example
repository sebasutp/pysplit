# Backend-only pointer.
#
# The canonical template is the repository-root .env.example. For a backend-only
# run, copy it to backend/.env; it is valid as-is (the VITE_* keys are ignored
# by the API):
#
#   cp ../.env.example .env        # from backend/
#   # or, from the repository root:
#   cp .env.example backend/.env
#
# Key authentication settings documented in full by the canonical template:
#   ENABLE_MOCK_LOGIN=false        # dev/test only; never in production
#   TRUST_FORWARDED_HEADERS=false  # only behind a trusted reverse proxy
#   BASE_URL=                      # production requires an http(s) URL
